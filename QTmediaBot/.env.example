# Telegram credentials. Keep the real values only in the ignored .env file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BASE_URL=https://api.telegram.org/bot
TELEGRAM_FILE_BASE_URL=https://api.telegram.org/file/bot
TELEGRAM_LOCAL_MODE=0
TELEGRAM_PRIVATE_CHATS_ONLY=1
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_DOMAINS=
TELEGRAM_MAX_UPLOAD_BYTES=1800000000
TELEGRAM_MAX_DURATION_SECONDS=3600
TELEGRAM_JOB_TTL_SECONDS=3600
TELEGRAM_JOB_ROOT=var/telegram_jobs
TELEGRAM_METADATA_DB=var/telegram_state/metadata.sqlite3
TELEGRAM_METADATA_TTL_SECONDS=900
TELEGRAM_ORPHAN_JOB_TTL_SECONDS=900
TELEGRAM_MAX_CONCURRENT_JOBS=1
TELEGRAM_DISK_RESERVE_BYTES=500000000
TELEGRAM_DOWNLOAD_TIMEOUT_SECONDS=7200
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=7200
TELEGRAM_UNCONFIRMED_UPLOAD_RETENTION_SECONDS=900
TELEGRAM_PROGRESS_UPDATE_SECONDS=10
TELEGRAM_RATE_LIMIT_REQUESTS=5
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60
TELEGRAM_MAX_QUEUED_JOBS=2

PRIVATE_SEARCH_YTDLP_JS_RUNTIME=node
PRIVATE_SEARCH_YTDLP_FORCE_IPV4=0
PRIVATE_SEARCH_CONCURRENT_FRAGMENTS=8
PRIVATE_SEARCH_HTTP_CHUNK_SIZE=
PRIVATE_SEARCH_YTDLP_COOKIES_FROM_BROWSER=
PRIVATE_SEARCH_YTDLP_COOKIES_BROWSER_PROFILE=
TELEGRAM_FIREFOX_PROFILE_ROOT=
