# Optional proxy used by the direct downloader
PRIVATE_SEARCH_PROXY=
PRIVATE_SEARCH_DOWNLOAD_TIMEOUT=60
PRIVATE_SEARCH_DOWNLOAD_RETRIES=5

# Optional isolated Blackbird worker for username and email OSINT
PRIVATE_SEARCH_BLACKBIRD_ROOT=
PRIVATE_SEARCH_BLACKBIRD_PYTHON=
PRIVATE_SEARCH_BLACKBIRD_TIMEOUT=300
PRIVATE_SEARCH_BLACKBIRD_THREADS=8
PRIVATE_SEARCH_BLACKBIRD_UPDATE_SITES=0

# Optional published SmartImage Rdx reverse-image search executable
PRIVATE_SEARCH_SMARTIMAGE_RDX=
PRIVATE_SEARCH_SMARTIMAGE_TIMEOUT=300
PRIVATE_SEARCH_SMARTIMAGE_UPLOAD_ENGINE=TmpFiles
PRIVATE_SEARCH_SMARTIMAGE_DOTNET=
PRIVATE_SEARCH_SMARTIMAGE_DLL=

# Optional isolated InsightFace worker for local face indexing and reverse-image matching
PRIVATE_SEARCH_INSIGHTFACE_ROOT=
PRIVATE_SEARCH_INSIGHTFACE_PYTHON=
PRIVATE_SEARCH_INSIGHTFACE_MODEL=buffalo_l
PRIVATE_SEARCH_INSIGHTFACE_IMAGE_ROOT=
PRIVATE_SEARCH_INSIGHTFACE_INDEX_PATH=
PRIVATE_SEARCH_INSIGHTFACE_CROP_ROOT=
PRIVATE_SEARCH_INSIGHTFACE_TIMEOUT=300
PRIVATE_SEARCH_INSIGHTFACE_PROVIDER_POLICY=cuda_or_cpu
PRIVATE_SEARCH_INSIGHTFACE_KEEP_CROPS=0

# Optional self-hosted Lustpress REST API, for example http://localhost:3000
LUSTPRESS_BASE_URL=

# Local llama.cpp runtime (the downloaded defaults under var/ are used when blank)
PRIVATE_SEARCH_LLM_SERVER=
PRIVATE_SEARCH_LLM_MODEL=
PRIVATE_SEARCH_LLM_MMPROJ=
PRIVATE_SEARCH_LLM_HOST=127.0.0.1
PRIVATE_SEARCH_LLM_PORT=8080
PRIVATE_SEARCH_LLM_CONTEXT=4096
PRIVATE_SEARCH_LLM_N_PREDICT=128
PRIVATE_SEARCH_LLM_DEVICE=CUDA0
PRIVATE_SEARCH_LLM_GPU_LAYERS=999
PRIVATE_SEARCH_LLM_STARTUP_TIMEOUT=60
PRIVATE_SEARCH_LLM_POLL_INTERVAL=0.25
PRIVATE_SEARCH_LLM_SHUTDOWN_TIMEOUT=5
