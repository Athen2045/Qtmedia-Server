# Optional proxy used by the CLI downloader
PRIVATE_SEARCH_PROXY=

# Optional browser profile used by curl-cffi when installed. The default is
# chrome131.
PRIVATE_SEARCH_IMPERSONATE=chrome131

# Optional transfer tuning. The CLI default is four fragments.
PRIVATE_SEARCH_CONCURRENT_FRAGMENTS=4
PRIVATE_SEARCH_HTTP_CHUNK_SIZE=

# Optional self-hosted Lustpress REST API, for example http://localhost:3000
LUSTPRESS_BASE_URL=

# yt-dlp challenge runtime; node is detected from PATH
PRIVATE_SEARCH_YTDLP_JS_RUNTIME=node
# Set to 1 to use yt-dlp's -4 behavior when a source rejects IPv6 media requests
PRIVATE_SEARCH_YTDLP_FORCE_IPV4=0
# Optional, disabled by default: read cookies locally from one browser
# Supported values include chrome, edge, firefox, brave, chromium, opera, safari, vivaldi
PRIVATE_SEARCH_YTDLP_COOKIES_FROM_BROWSER=
# Optional browser profile name/path
PRIVATE_SEARCH_YTDLP_COOKIES_BROWSER_PROFILE=
# Optional CLI-only browser cookie settings
PRIVATE_SEARCH_CLI_YTDLP_COOKIES_FROM_BROWSER=
PRIVATE_SEARCH_CLI_YTDLP_COOKIES_BROWSER_PROFILE=
# Set this to the full User-Agent reported by that Firefox profile.
PRIVATE_SEARCH_CLI_YTDLP_USER_AGENT=
